import cv2
import numpy as np
def cv_show(name,img):
    cv2.imshow(name,img) #显示图片
    cv2.waitKey(0) #等待按键
    cv2.destroyAllWindows() #关闭所有窗口
img = cv2.imread(r"G:\136b9d4075769c0b28950c3325e9fa16.jpg") #读取图片
#高斯函数就是正态分布
#高斯滤波
#高斯模糊的卷积核里的数值时满足高斯分布，相当于更重视中间的
aussian = cv2.GaussianBlur(img,(5,5),0) #卷积核为5*5  第三个参数为标准差
# print(cv_show("gaussian",aussian)) #显示图片
#中值滤波
#相当于用中值代替
median = cv2.medianBlur(img,5) #卷积核为5*5
# print(cv_show("median",median)) #显示图片
#均值滤波
blur = cv2.blur(img,(5,5)) #卷积核为5*5
# print(cv_show("blurred",blur)) #显示图片
#展示所有的
res = np.hstack((blur,aussian,median))
print(cv_show("res",res)) #显示图片