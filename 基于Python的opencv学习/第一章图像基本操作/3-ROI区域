#ROI区域：Region of Interest，感兴趣的区域
#只取图像中的一部分
import cv2
def cv_show(name,img):
    cv2.imshow(name,img) #显示图片
    cv2.waitKey(0) #等待按键
    cv2.destroyAllWindows() #关闭所有窗口
img = cv2.imread(r"G:\136b9d4075769c0b28950c3325e9fa16.jpg") #读取图片
cat = img[0:200,0:200] #取出图像的前200行，前200列
print(cv_show("cat", cat)) 
#颜色通道提取
b,g,r=cv2.split(img)
print(b)
print(b.shape)
img = cv2.merge((b,g,r))
print(img.shape)
#只保留R
cur_img = img.copy()
cur_img[:,:,0] = 0
cur_img[:,:,1] = 0
print(cv_show('R',cur_img))
#只保留G
cur_img = img.copy()
cur_img[:,:,0] = 0
cur_img[:,:,2] = 0
print(cv_show('G',cur_img))
#只保留B
cur_img = img.copy()
cur_img[:,:,1] = 0
cur_img[:,:,2] = 0
print(cv_show('B',cur_img))